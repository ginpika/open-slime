    "test:agents:browser": "node tests/agent-capabilities-browser-check.mjs",
    "test:web": "node --test tests/readable-url.test.mjs tests/browser-wheel.test.mjs",
    "test:economy": "node --test tests/economy.test.mjs tests/navigation.test.mjs tests/browser-wheel.test.mjs",
