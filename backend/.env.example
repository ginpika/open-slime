# 后端可选部署参数：本地开发无需创建 .env，默认配置即可启动。
# Docker Compose 首次运行需复制本文件为 backend/.env，可直接保留全注释内容。
# 只有需要覆盖默认值时才取消对应行的注释；真实环境变量优先于 .env。
#
# 启动后在页面配置，自动保存到 SQLite，无需在此填写：
# - 设置页：添加大模型并设为默认，配置 Embedding / Rerank、DeepSeek Search / Fetch、TTS、ComfyUI。
# - 提示词页：维护提示词；工作空间页：维护 Docker / SSH 目标、凭证与启用状态。
# 旧版 LLM_* / EMBEDDING_MODEL / RERANK_MODEL 仍兼容，作为内置项或兜底配置；新部署建议使用页面。

# ---- 服务与存储（默认值如下；路径相对 backend 工作目录）----
# Docker Compose 已设置容器端口与数据路径；宿主机端口由根目录 .env 的 MINIS_HOST_PORT 覆盖。
# MINIS_PORT=18081
# MINIS_DB_PATH=../data/minis.db
# MINIS_ARTICLE_DIR=../data/article
# MINIS_LOG_FILE=../data/logs/minis.log
# MINIS_PUBLIC_BASE=http://localhost:18081

# ---- SSO（默认关闭；接入时填写服务地址）----
# SSO_SERVER_URL=
# SSO_COOKIE_NAME=sso_token

# ---- 网页浏览器（默认自动发现，无需填写）----
# Windows 自动查找 Chrome / Edge；其他平台使用已安装的 Chromium。
# MINIS_WEB_EXECUTABLE_PATH=
# MINIS_WEB_HEADLESS=true
# MINIS_WEB_LOCALE=zh-CN
# MINIS_WEB_TIMEZONE=Asia/Shanghai
# MINIS_WEB_PROXY_SERVER=
# 仅在代理使用 198.18.0.0/15 Fake-IP DNS 时开启。
# MINIS_WEB_ALLOW_FAKE_IP=false

# ---- 命令行终端护栏（全局默认值；目标与凭证在工作空间页维护）----
# TERMINAL_TIMEOUT_MS=60000
# TERMINAL_MAX_OUTPUT=20000

# ---- 编程 Agent 执行环境（按需配置；PLAN / EDIT 不需要 Docker）----
# MINIS_CODING_ENABLED=true
# 默认数据目录为 SQLite 数据文件旁的 coding 目录。
# MINIS_CODING_DIR=
# 后端在容器内时，填写上述目录对应的 Docker 宿主机路径。
# MINIS_CODING_HOST_DIR=
# EXECUTE 使用的工具链镜像，需在 Docker 宿主机预先准备。
# MINIS_CODING_IMAGE=maven:3.9-eclipse-temurin-21
# 本机执行具有宿主权限，默认关闭。
# MINIS_CODING_LOCAL_EXECUTION=false

# ---- 编程 Agent 限额（以下是默认值，无需逐项配置）----
# MINIS_CODING_MAX_MINUTES=30
# 累计 token 额度：0 不限制；正数限制每次运行，按供应商 usage（缺失时估算）。
# MINIS_CODING_MAX_TOKENS=0
# 单次输出：0 跟随模型服务；模型设置页指定的单次输出上限优先。
# MINIS_CODING_RESPONSE_TOKENS=0
# 未知输出能力时的上下文预留，不是单次输出硬上限。
# MINIS_CODING_RESPONSE_RESERVE=32768
# MINIS_CODING_OUTPUT_CONTINUATIONS=3
# MINIS_CODING_SUBAGENTS=2
# MINIS_CODING_MODEL_RETRIES=3

# 完整参数见 src/main/resources/application.yaml；编程参数说明见 src/main/java/cc/ginpika/minis/coding/README.md。
