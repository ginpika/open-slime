# minis 后端环境参数模板：复制为 backend/.env 后按需填写（.env 已被 .gitignore 排除）
# 真实环境变量优先级高于 .env（部署环境可直接用环境变量覆盖）

# ---- LLM（OpenAI Compatible：聊天 + Embedding 共用）----
# 带版本前缀的端点，例如 https://api.openai.com/v1 / https://api.deepseek.com/v1
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-xxx
# AI 会话模型（/chat/completions）
LLM_CHAT_MODEL=gpt-4o-mini
# 可选：聊天默认 system prompt（留空则不发送）
LLM_SYSTEM_PROMPT=
# 可选：内置模型上下文窗口（token 数，默认 262144）；会话页上下文占比圆环用
# LLM_CONTEXT_WINDOW=262144

# ---- Embedding（固定供应商+模型；换模型需全库重嵌）----
EMBEDDING_MODEL=text-embedding-3-small

# ---- Rerank（可选，留空则不启用精排，RAG 保持 RRF 序）----
# 复用 LLM_BASE_URL / LLM_API_KEY，走 POST {base}/rerank
# RERANK_MODEL=

# ---- 运行（可选）----
# MINIS_PORT=18081
# MINIS_DB_PATH=../data/minis.db
# MINIS_ARTICLE_DIR=../data/article
# MINIS_PUBLIC_BASE=http://localhost:8081

# ---- SSO（可选，dev 留空即关闭）----
# SSO_SERVER_URL=
# SSO_COOKIE_NAME=sso_token

# ---- FAST 联网补充（可选，默认关）----
# FAST_WEB_ENABLED=false

# ---- 命令行终端（可选）----
# 让模型直接控制工作空间（docker 容器 / SSH 服务器，清单在工作空间页维护）。
# 没有全局开关：开了就等于把命令执行权交给模型，请按需逐个工作空间启用。
# TERMINAL_TIMEOUT_MS=60000
# TERMINAL_MAX_OUTPUT=20000
# 网页浏览器与快照：Windows 可自动使用 Chrome / Edge；Linux 可运行 Playwright CLI 安装 Chromium。
MINIS_WEB_EXECUTABLE_PATH=
MINIS_WEB_HEADLESS=true
MINIS_WEB_LOCALE=zh-CN
MINIS_WEB_TIMEZONE=Asia/Shanghai
MINIS_WEB_ALLOW_FAKE_IP=false
MINIS_WEB_PROXY_SERVER=

# ---- 自研编程 Agent（可选）----
# 数据目录留空时跟随 SQLite 数据目录；原仓库需由后端可访问且至少有一个提交。
MINIS_CODING_ENABLED=true
MINIS_CODING_DIR=
MINIS_CODING_IMAGE=maven:3.9-eclipse-temurin-21
# 后端在容器内时，填写与 MINIS_CODING_DIR 对应的 Docker 宿主机路径；不要给模型容器挂 Docker socket。
MINIS_CODING_HOST_DIR=
# 本机执行有宿主权限，默认关闭；PLAN/EDIT 不需要 Docker。
MINIS_CODING_LOCAL_EXECUTION=false
MINIS_CODING_MAX_ROUNDS=60
MINIS_CODING_MAX_MINUTES=30
# 累计 token 额度：0 不限制；正数按供应商 usage（缺失时估算）限制每次运行。
MINIS_CODING_MAX_TOKENS=0
# 单次模型输出：0 跟随模型服务；模型设置页指定的单次输出上限优先。不同于累计任务预算。
MINIS_CODING_RESPONSE_TOKENS=0
MINIS_CODING_RESPONSE_RESERVE=32768
MINIS_CODING_OUTPUT_CONTINUATIONS=3
MINIS_CODING_SUBAGENTS=2
MINIS_CODING_MODEL_RETRIES=3
MINIS_CODING_SUBAGENT_ROUNDS=30
